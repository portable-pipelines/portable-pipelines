# JSON and CSV portable extensions, plus $name in SPEC and PICK.

%% json-add-pick-spec
literal {"customer":"Ann","qty":3,"price":40} | json add total = $qty * $price | pick $total > /100/ | spec $customer 1 / spent / next $total next | console
=> Ann spent 120

%% json-csv-literal-path
literal Ann,3,40| literal customer,qty,price| csv | json add total = $qty * $price | pick $total > /100/ | spec $customer 1 / spent / next $total next | console
=> Ann spent 120

%% json-set-get
literal {"n":1} | json set n = $n + 4 | json get n | console
=> 5

%% json-keep-get
literal {"a":1,"b":2,"c":3}| json keep a c | json get a | console
=> 1

%% json-not-object
literal hello | json get name | hole
=> error: not a JSON object

%% json-add-exists
literal {"n":1} | json add n = 2 | hole
=> error: already exists

%% spec-missing-field-empty
literal {"name":"Ann"} | spec $name 1 /:/ next $missing next | console
=> Ann:

%% pick-missing-field-drops
literal {"region":"East"} | pick $amount > /0/ | console
=> (empty)

%% csv-east-filter
< examples/orders.csv | csv | pick $region == /East/ | spec $name 1 / / next $amount next | console
=> Ann 120 / Cam 200

%% csv-write-round-trip
literal Ann,3,40| literal customer,qty,price| csv | csv write | console
=> customer,qty,price / Ann,3,40

%% csv-strings-zip
literal 007| literal zip| csv strings | json get zip | console
=> 007

%% copy-plain-text-unchanged
literal hello| copy | console
=> hello

%% json-index-dot
< examples/order.json | spec $items.0.sku 1 | console
=> NUT

%% json-split-items
< examples/order.json | json split items | spec $sku 1 | console
=> NUT / BOLT

%% json-split-keep
< examples/order.json | json split items keep | spec $order 1 / / next $sku next | console
=> A-1 NUT / A-1 BOLT

%% json-array-pretty
< examples/catalog.json | json array | spec $name 1 / / next $city next | console
=> Ann Oslo / Cam Leeds

%% json-array-scalars
literal [1,2,3] | json array | spec $value 1 | console
=> 1 / 2 / 3

%% json-collect
< examples/order.json | json split items | json collect items | json get items | console
=> [{"sku":"NUT","qty":2},{"sku":"BOLT","qty":10}]

%% json-add-quoted-string
strliteral /{"bleh":"hi"}/ | json add shout = $bleh + "!" | json get shout | console
=> hi!

%% json-index-missing-empty
literal {"tags":["a"]} | spec $tags.9 1 | console
=> ""

%% json-split-empty
literal {"tags":[]} | json split tags | console
=> (empty)

%% json-array-not-array
literal {"a":1} | json array | hole
=> error: not a JSON array
