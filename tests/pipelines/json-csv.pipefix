# JSON and CSV stages, plus $field in SPEC and PICK.

%% json-add-pick-spec
< examples/orders.csv | csv | take 1 | json add $total = $qty * $amount | pick $total > /100/ | spec $customer 1 / spent / next $total next | console
=> Ann spent 360

%% json-csv-file-path
< examples/orders.csv | csv | json add $total = $qty * $amount | pick $total > /100/ | spec $customer 1 / spent / next $total next | console
=> Ann spent 360 / Cam spent 400

%% json-set-get
< examples/orders.csv | csv | json set $qty = $qty + 4 | json get $qty | console
=> 7 / 5 / 6

%% json-keep-get
< examples/orders.csv | csv | take 1 | json keep $customer $qty | json get $customer | console
=> Ann

%% json-not-object
< examples/notes.txt | json get $city | hole
=> error: not a JSON object

%% json-add-exists
< examples/orders.csv | csv | json add $qty = 1 | hole
=> error: already exists

%% spec-missing-field-empty
< examples/orders.csv | csv | spec $customer 1 /:/ next $price next | console
=> Ann: / Ben: / Cam:

%% pick-missing-field-drops
< examples/orders.csv | csv | pick $price > /0/ | console
=> (empty)

%% csv-east-filter
< examples/orders.csv | csv | pick $region == /East/ | spec $customer 1 / / next $amount next | console
=> Ann 120 / Cam 200

%% csv-write-round-trip
< examples/orders.csv | csv | csv write | console
=> customer,amount,region,qty / Ann,120,East,3 / Ben,80,West,1 / Cam,200,East,2

%% csv-leading-zero-zip
< examples/contacts.csv | csv | json get $zip | console
=> 007 / 012

%% copy-plain-text-unchanged
< examples/notes.txt | copy | console
=> Buy milk / Call the library

%% json-index-dot
< examples/library.json | spec $books.0.title 1 | console
=> Dune

%% json-split-items
< examples/library.json | json split $books | spec $title 1 | console
=> Dune / Emma

%% json-split-keep
< examples/library.json | json split $books keep | spec $branch 1 / / next $title next | console
=> Downtown Dune / Downtown Emma

%% json-array-pretty
< examples/catalog.json | json array | spec $customer 1 / / next $city next | console
=> Ann Oslo / Cam Leeds

%% json-array-scalars
< examples/scores.json | json array | spec $value 1 | console
=> 90 / 85 / 72

%% json-collect
< examples/library.json | json split $books | json collect $books | json get $books | console
=> [{"title":"Dune","copies":3},{"title":"Emma","copies":1}]

%% json-add-quoted-string
< examples/catalog.json | json array | take 1 | json add $shout = $city + /!/ | json get $shout | console
=> Oslo!

%% json-index-missing-empty
< examples/library.json | spec $books.9.title 1 | console
=> ""

%% json-split-empty
< examples/inbox.json | json split $messages | console
=> (empty)

%% json-array-not-array
< examples/library.json | json array | hole
=> error: not a JSON array

%% json-null-field-empty
< examples/guest.json | spec $city 1 /:/ next $note next | console
=> Oslo:

%% json-invalid-json
< examples/broken.json | json get $city | hole
=> error: not a JSON object

%% csv-write-not-object
< examples/notes.txt | csv write | hole
=> error: not a JSON object

%% json-object-numeric-key
< examples/aisles.json | spec $aisles.0 1 | console
=> Fiction

%% json-object-numeric-key-bracket
< examples/aisles.json | spec $aisles[1] 1 | console
=> History

%% csv-strings-times-error
< examples/orders.csv | csv strings | take 1 | json add $doubled = $qty * 2 | hole
=> error: read without STRINGS

%% pick-bang-not-equal-region
< examples/orders.csv | csv | pick $region !== /West/ | spec $customer 1 | console
=> Ann / Cam

%% pick-bang-not-equal-amount
< examples/orders.csv | csv | pick $amount != /80/ | spec $customer 1 | console
=> Ann / Cam

%% pick-slash-not-equal-clash
< examples/orders.csv | csv | pick $amount /= /0/ | hole
=> error: clashes with /strings/

%% sort-json-field
< examples/orders.csv | csv | sort $region $customer | spec $customer 1 / / next $region next | console
=> Ann East / Cam East / Ben West

%% locate-json-field
< examples/orders.csv | csv | locate $region /West/ | spec $customer 1 | console
=> Ben

%% nlocate-json-field
< examples/orders.csv | csv | nlocate $region /West/ | spec $customer 1 | console
=> Ann / Cam

%% change-json-field
< examples/orders.csv | csv | take 1 | change $region /East/North/ | json get $region | console
=> North

%% json-get-missing-bare
< examples/orders.csv | csv | json get price | hole
=> error: field price is missing

%% json-get-missing-dollar
< examples/orders.csv | csv | json get $price | hole
=> error: field $price is missing

%% json-split-missing-bare
< examples/library.json | json split tags | hole
=> error: field tags is missing

%% sort-json-not-object
< examples/notes.txt | sort $city | hole
=> error: not a JSON object
