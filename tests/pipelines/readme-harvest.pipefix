=> "         2ab" / "         1c"

%% readme-058-literal-split-joincont
literal one two\ three four | split | joincont /\/ | console
=> one / twothree / four

%% readme-059-literal-split-joincont
literal This, is, the, first, sentence. | split | joincont /,/ / / | console
=> This is the first sentence.

%% readme-060-literal-split-joincont
literal This, is, the, first, sentence. | split | joincont not /./ | console
=> This,is,the,first,sentence.

