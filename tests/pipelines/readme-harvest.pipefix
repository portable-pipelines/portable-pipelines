%% readme-phase1-cascade
disk examples/lines.txt | take 20 | nlocate /x/ | strip | console
=> apple / banana / apricot / spaced / Xy / a.b. / todo: one / todo: two / done: three / "" / blank-above

%% readme-preface-self-escape
literal c d e| preface literal a b || split | console
=> a / b / c d e

%% readme-preface-sep
(sep ?) literal c d e? preface literal a b | split ? console
=> a / b / c d e

%% readme-append-self-escape
literal c d e| append literal a b || split | console
=> c d e / a / b

%% readme-append-sep
(sep ?) literal c d e? append literal a b | split ? console
=> c d e / a / b

%% readme-append-literal-trailer
literal c d e| append literal *** End of data *** | console
=> c d e / *** End of data ***

%% readme-lookup-default-match
(ENDCHAR ?) literal apple apricot banana| split | L: lookup | console ? literal apple banana cherry| split | L: | hole
=> apple / apple / banana / banana

%% readme-lookup-unmatched
(ENDCHAR ?) literal apple apricot banana| split | L: lookup | hole ? literal apple banana cherry| split | L: | console
=> apricot

%% readme-lookup-leftover
(ENDCHAR ?) literal apple| L: lookup | hole ? literal apple cherry| split | L: | hole ? L: | console
=> cherry

%% readme-lookup-count
(ENDCHAR ?) literal a a b| split | L: lookup count | hole ? literal a c| split | L: | hole ? L: | console
=> "         2a" / "         0c"

%% readme-lookup-autoadd-first
(ENDCHAR ?) literal aaaaa bbbbb aaaaa ccccc aaaaa| split | L: lookup 1.5 autoadd keyonly | hole ? L: | console
=> aaaaa / bbbbb / ccccc

%% readme-lookup-stop-words
(ENDCHAR ?) literal the cat and the hat| split | L: lookup | hole ? literal the and of| split | L: | console
=> cat / hat

%% readme-lookup-anycase
(ENDCHAR ?) literal Foo| L: lookup anycase | console ? literal foo| L: | hole
=> Foo / foo

