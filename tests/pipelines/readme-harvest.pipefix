examples/emit.rexx a b c d | take last 2 | console
=> c / d

%% readme-014-emit-take
examples/emit.rexx a b c d | take last * | console
=> a / b / c / d

%% readme-015-emit-take
examples/emit.rexx a b c d | take * | console
=> a / b / c / d

%% readme-016-take
(ENDCHAR ?) examples/emit.rexx a b c d | T: take 0 | console ? T: | hole
=> (empty)

%% readme-017-take
(ENDCHAR ?) examples/emit.rexx a b c d | T: take 2 | console ? T: | console
=> primary: a / b
=> secondary: c / d

%% readme-018-emit-drop
examples/emit.rexx a b c d | drop | console
=> b / c / d

%% readme-019-emit-drop
examples/emit.rexx a b c d | drop 2 | console
=> c / d

