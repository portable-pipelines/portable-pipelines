# Harvested from examples/README.md `pipe "…"` lines.
# CONSOLE is rewritten to a collector at run time. See tests/pipelines/README.md.
# ␠ in expected records is a space. Split on ' / '. Quoted records keep interiors.

%% readme-file-in-locate-todo
< examples/lines.txt | locate /todo/ | console
=> todo: one / todo: two

%% readme-file-replace
literal hi | > /tmp/out.txt
skip: writes a host file; not a record assertion

%% readme-file-append
literal more | >> /tmp/out.txt
skip: writes a host file; not a record assertion

%% readme-004-literal-change
literal abc| change x6162 x5858 | console
=> XXc

%% readme-005-locate-prefix
(ENDCHAR ?) ./examples/emit.rexx apple banana apricot | L: locate /ap/ | console ? L: | ./examples/prefix.rexx miss= | console
=> primary: apple / apricot
=> secondary: miss=banana

%% readme-006-nlocate-prefix
(ENDCHAR ?) ./examples/emit.rexx ax b x | L: nlocate /x/ | console ? L: | ./examples/prefix.rexx hit= | console
=> primary: b
=> secondary: hit=ax / hit=x

%% readme-007-take-prefix
(ENDCHAR ?) ./examples/emit.rexx a b c d | T: take 2 | console ? T: | ./examples/prefix.rexx rest= | console
=> primary: a / b
=> secondary: rest=c / rest=d

%% readme-locate-todo-secondary-prefix
(ENDCHAR ?) disk ./examples/lines.txt | L: locate /todo/ | console ? L: | ./examples/prefix.rexx other= | console
=> primary: todo: one / todo: two
=> secondary: other=apple / other=banana / other=apricot / "other=  spaced  " / other=xx / other=Xy / other=a.b. / other=done: three / other= / other=blank-above

