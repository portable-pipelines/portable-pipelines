%% readme-049-literal-split-join
literal a few words in a sentence | split | join | console
=> afew / wordsin / asentence

%% readme-050-literal-split-join
literal a few words in a sentence | split | join 2 | console
=> afewwords / inasentence

%% readme-051-literal-split-join
literal a few words in a sentence | split | join 2 /**/ | console
=> a**few**words / in**a**sentence

