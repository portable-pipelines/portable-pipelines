# PIPCMD (Author's Edition 1.1.11 pp.457–458). Extra cases beyond README harvest.

%% pipcmd-output-null
literal output| pipcmd | console
=> ""

%% pipcmd-stop-alleof-keyword
literal output hi| pipcmd stop alleof | console
=> hi

%% pipcmd-stop-count
literal output z|literal output y|literal output x| pipcmd stop 1 | take 1 | console
=> x

%% pipcmd-resolve-insert
literal resolve insert | pipcmd | hole
=> (empty)

%% pipcmd-unknown-command
literal nosuchcmd | pipcmd | hole
=> (empty)

%% pipcmd-stop-missing-keyword
literal a | pipcmd anyeof | hole
=> error: unrecognized operand

%% pipcmd-stop-invented
literal a | pipcmd stop forever | hole
=> error: unrecognized STOP operand

%% pipcmd-stop-extra
literal a | pipcmd stop alleof extra | hole
=> error: unrecognized operand

%% pipcmd-peekto
literal peekto | pipcmd | hole
=> error: not available to PIPCMD

%% pipcmd-setrc
literal setrc 0 | pipcmd | hole
=> (empty)

%% pipcmd-addstream
literal addstream | pipcmd | hole
=> (empty)

%% pipcmd-eofreport
literal eofreport current | pipcmd | hole
=> (empty)

%% pipcmd-maxstream
literal maxstream output | pipcmd | hole
=> (empty)

%% pipcmd-stagenum
literal stagenum | pipcmd | hole
=> (empty)

%% pipcmd-streamnum
literal streamnum output | pipcmd | hole
=> (empty)

%% pipcmd-streamstate
literal streamstate output | pipcmd | hole
=> (empty)

%% pipcmd-suspend
literal suspend | pipcmd | hole
=> (empty)

%% pipcmd-sever-output
literal output x|literal sever output | pipcmd | hole
=> (empty)

%% pipcmd-commit
literal commit 0 | pipcmd | hole
=> (empty)

%% pipcmd-select-both
literal select both 0 | pipcmd | hole
=> (empty)

%% pipcmd-resolve-missing-arg
literal resolve | pipcmd | hole
=> (empty)

%% pipcmd-unknown-is-silent
literal nosuch | pipcmd | hole
=> (empty)

%% pipcmd-readto-rejected
literal readto line | pipcmd | hole
=> error: not available to PIPCMD

%% pipcmd-begoutput-rejected
literal begoutput | pipcmd | hole
=> error: not available to PIPCMD

%% pipcmd-nocommit-rejected
literal nocommit | pipcmd | hole
=> error: not available to PIPCMD

%% pipcmd-setrc-bad-arg
literal setrc foo | pipcmd | hole
=> (empty)
