/target
**/*.rs.bk
.idea/
.vscode/
*.pdb

# IBM copyrighted reference PDFs (keep local only)
docs/reference/*.pdf

# Local PDF text extracts / scratch (not for commit)
docs/*-extract.tmp.txt
docs/_*.tmp.txt

# Windows packaging output (pipe.exe zip staging). Do not commit third-party DLLs or zips.
/dist/

# Python helper bytecode (created when tests spawn an interpreter)
**/__pycache__/
*.pyc

# Showcase host-file sink (README example writes this)
examples/showcase/sales.jsonl

# Generated CALLPIPE file-set demo data (generator default is the process
# temp dir; this catches a local -OutDir / --outdir under examples/)
examples/callpipe-data/
