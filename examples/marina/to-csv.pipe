(ENDCHAR ?) < examples/marina/vessels.jsonl | f: fanout | json keep $vessel_id $name $type $berth_id $owner_id | csv write | > examples/marina/out/vessels.csv ? f: | spec $owner 1 | sort $owner_id | unique | csv write | > examples/marina/out/owners.csv ? f: | spec $berth 1 | sort $berth_id | unique | csv write | > examples/marina/out/berths.csv ? f: | json split $work_orders | sort $work_order_id | csv write | > examples/marina/out/work_orders.csv
